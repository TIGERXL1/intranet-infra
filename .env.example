DATABASE_URL=postgresql://user:password@localhost:5432/intranet
NODE_ENV=development

# Service check hosts
DNS_HOST=192.168.10.5
DNS_PORT=53
# Domain to probe - must be a zone known to this Bind9 instance
# Zone entreprise.local is configured on SRV-DNS (srv-dns.entreprise.local)
DNS_PROBE_DOMAIN=entreprise.local
LDAP_HOST=192.168.10.10
LDAP_PORT=389
NEXTCLOUD_URL=https://192.168.10.20
NEXTCLOUD_LOG_HOST=192.168.10.20
NEXTCLOUD_TLS_VERIFY=false
PROXMOX_URL=https://192.168.1.33:8006
PROXMOX_LOG_HOST=192.168.1.33
PROXMOX_TLS_VERIFY=false

# Scheduler
CHECK_INTERVAL_SECONDS=60
LOG_COLLECT_INTERVAL_SECONDS=300

# SSH log collection
SSH_LOG_USER=intranet-monitor
SSH_KEY_PATH=/home/user/.ssh/intranet_monitor_ed25519
SSH_LOG_LINES=500

# Degraded thresholds (ms)
DEGRADED_DNS_MS=200
DEGRADED_LDAP_MS=500
DEGRADED_NEXTCLOUD_MS=2000
DEGRADED_PROXMOX_MS=1000
